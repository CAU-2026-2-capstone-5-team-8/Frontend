{
  "name": "bookpath-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    }
  },
  "scripts": {
    "test:catalog-covers": "node --test tests/catalogCovers.test.mjs",
    "test:query-decoding": "node --test tests/queryDecoding.test.mjs",
    "test:presentation": "node --experimental-strip-types --test tests/bookPresentation.test.mjs",
    "test:learning": "node --experimental-strip-types --test tests/learningRecommendations.test.mjs",
    "start": "node scripts/build-katex-css.mjs && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run build:web && npm run serve:web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "node scripts/build-katex-css.mjs && expo export --platform web",
    "test:content": "node --experimental-strip-types --test tests/questionContent.test.mjs",
    "validate:questions": "node --experimental-strip-types scripts/validate-question-content.mjs",
    "postinstall": "patch-package --error-on-fail && node scripts/build-katex-css.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:proxy": "node --test tests/webProxy.test.mjs"
  },
  "private": true
}
